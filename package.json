{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run typecheck && vite build && npm run pages && npm run prerender && npm run sitemap",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc && tsc -p tsconfig.node.json --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "pages": "node scripts/gen-pages.mjs",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "axios": "^1.9.0",
    "framer-motion": "^11.16.4",
    "i18next": "^25.1.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "lenis": "^1.3.4",
    "modern-normalize": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.4.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.25.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
